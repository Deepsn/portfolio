---
import "../styles/global.css";

import { Font } from "astro:assets";
import Header from "@/components/layout/Header.astro";
import { LangtonAnt } from "../components/LangtonAnt";
---

<!doctype html>
<html class="scroll-smooth" lang="en">
	<head>
		<meta charset="utf-8">
		<meta content="width=device-width" name="viewport">
		<link href="/favicon.svg" rel="icon" type="image/svg+xml">
		<link href="/favicon.ico" rel="icon">
		<meta content={Astro.generator} name="generator">
		<title>Portfolio</title>
		<Font cssVariable="--font-geist" preload />
		<Font cssVariable="--font-geist-mono" />
	</head>

	<body class="relative isolate flex min-h-dvh flex-col bg-background">
		<Header />
		<main class="relative z-0 flex flex-col mt-16">
			<slot />
		</main>
		<LangtonAnt client:load />
	</body>
</html>
