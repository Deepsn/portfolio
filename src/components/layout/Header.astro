---
const links = [
	{ label: "projects", href: "/#projects" },
	{ label: "career", href: "/#career" },
	{ label: "academic", href: "/#academic" },
	{ label: "about", href: "/about" },
	{ label: "source", href: "https://github.com/Deepsn/portfolio" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<header
	class="fixed inset-x-0 top-0 z-20 px-4 pt-3 sm:px-6 flex justify-center"
>
	<nav
		class="frame flex h-12 items-center gap-4 px-3 font-mono max-w-max text-xs sm:gap-6 sm:pl-4 sm:text-sm"
	>
		<ul class="flex items-center gap-4 sm:gap-6">
			{
				links.map((link) => {
					const isCurrent = link.href === currentPath;

					return (
						<li>
							<a
								class:list={[
									"group flex items-center gap-2 transition-colors hover:text-foreground",
									isCurrent
										? "text-foreground"
										: "text-muted-foreground",
								]}
								href={link.href}
							>
								{link.href.includes("#") ? "#" : "/"}
								{link.label}
							</a>
						</li>
					);
				})
			}
		</ul>
	</nav>
</header>
