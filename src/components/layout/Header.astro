---
const links = [
	{ label: "stuff", href: "/#stuff" },
	{ label: "about", href: "/about" },
	{ label: "contact", href: "/#contact" },
];
---

<header class="fixed inset-x-0 top-0 z-20 border-b border-border bg-background/85 backdrop-blur-md">
	<nav class="mx-auto flex h-16 max-w-6xl items-center px-4 font-mono text-sm sm:px-6">
		<ul class="flex items-center gap-6 text-muted-foreground">
			{links.map((link) => (
	<li>
		<a class="group flex items-center gap-2 transition-colors hover:text-foreground" href={link.href}>
			<span aria-hidden="true" class="size-1.5 bg-border transition-colors group-hover:bg-primary"></span>
			{link.label}
		</a>
	</li>
))}
		</ul>
	</nav>
</header>
