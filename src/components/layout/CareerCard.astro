---
import PopupArrow from "@/assets/icons/popup-arrow.svg";
import type { Career } from "@/data/career";

type Props = Career;

const { period, title, employer, responsibilities, logo, link } = Astro.props;

const periodString = [period.start, period.end ?? (period.current && "Present")].filter(Boolean).join(" - ");
const periodDuration =
	period.start && (period.end || period.current)
		? new Date(period.end ?? new Date()).getTime() - new Date(period.start).getTime()
		: 0;
---

<li
	class="group p-5 grid grid-cols-[3.5rem_1fr] gap-x-4 gap-y-3 border-b border-border transition-colors hover:bg-primary/3 sm:grid-cols-[3rem_1fr_auto] sm:items-start"
>
	<span class="col-span-2 sm:col-span-1 pt-1.5">
		{logo && <img alt="career logo" class="rounded-sm" src={logo} />}
	</span>

	<div class="col-span-2 flex min-w-0 gap-4 sm:col-span-1">
		<div class="min-w-0">
			<h3 class="text-lg font-semibold tracking-tight group-hover:text-primary">{title}</h3>

			{employer && <p class="font-mono text-xs text-accent">{employer}</p>}

			<p class="font-mono text-xs text-muted-foreground group-hover:text-primary">
				{periodString}
				{" "}
				{periodDuration > 0 && `(${Math.floor(periodDuration / (1000 * 60 * 60 * 24 * 30))} months)`}
			</p>

			{responsibilities && responsibilities.length > 0 && (
	<ul class="mt-3 flex max-w-2xl flex-col gap-1.5 text-sm text-muted-foreground">
		{responsibilities.map((item) => (
			<li class="flex gap-2">
				<span aria-hidden="true" class="mt-2 size-1.5 shrink-0 bg-accent/70" />
				{item}
			</li>
		))}
	</ul>
)}
		</div>
	</div>

	{link && (
	<div class="col-span-2 font-mono text-sm sm:col-span-1 sm:pt-1">
		<a
			class="inline-flex items-center text-muted-foreground underline-offset-4 transition-colors hover:text-primary hover:underline"
			href={link}
			rel="noreferrer"
			target="_blank"
		>
			visit <PopupArrow />
		</a>
	</div>
)}
</li>
