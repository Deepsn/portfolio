---
import PopupArrow from "@/assets/icons/popup-arrow.svg";
import type { Project } from "@/data/projects";

type Props = Project;

const { title, description, logo, tags, links } = Astro.props;
---

<li
	class="group p-5 grid grid-cols-[3.5rem_1fr] gap-x-4 gap-y-3 border-b border-border transition-colors hover:bg-primary/3 sm:grid-cols-[3rem_1fr_auto] sm:items-start"
>
	<span class="col-span-2 sm:col-span-1 pt-1.5">
		{
			logo && (
				<img
					alt="project logo"
					class="rounded-sm w-12 h-12 object-contain"
					src={logo}
				/>
			)
		}
	</span>

	<div class="col-span-2 min-w-0 sm:col-span-1">
		<h3
			class="text-lg font-semibold tracking-tight transition-colors group-hover:text-primary"
		>
			{title}
		</h3>

		<p
			class="mt-1 max-w-xl text-sm text-muted-foreground first-letter:uppercase"
		>
			{description}
		</p>

		<ul
			class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted-foreground"
		>
			{
				tags.map((tag) => (
					<li class="inline-flex items-center gap-1.5">
						<span
							aria-hidden="true"
							class="size-1.5 bg-accent/70"
						/>
						{tag}
					</li>
				))
			}
		</ul>
	</div>

	<div
		class="col-span-2 flex flex-wrap gap-4 font-mono text-sm sm:col-span-1 sm:flex-col sm:gap-1 sm:pt-1"
	>
		{
			links.map((link) => (
				<a
					class="inline-flex items-center text-muted-foreground underline-offset-4 transition-colors hover:text-primary hover:underline"
					href={link.href}
					rel="noreferrer"
					target="_blank"
				>
					{link.label} <PopupArrow />
				</a>
			))
		}
	</div>
</li>
