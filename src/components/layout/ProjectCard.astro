---
import PopupArrow from "@/assets/icons/popup-arrow.svg";
import type { Project } from "@/data/projects";

type Props = Project;

const { title, description, logo, tags, links } = Astro.props;
---

<li
	class="group grid grid-cols-[3.5rem_1fr] gap-x-5 gap-y-3 border-b border-border p-5 transition-colors hover:bg-primary/3 sm:grid-cols-[3.5rem_1fr_auto] sm:items-start"
>
	<span class="col-span-2 sm:col-span-1 pt-1.5 flex items-center h-full">
		{logo && <img alt="project logo" class="rounded-sm" src={logo} />}
	</span>

	<div class="min-w-0">
		<h3 class="text-lg font-semibold tracking-tight transition-colors group-hover:text-primary">
			{title}
		</h3>

		<p class="mt-1 max-w-xl text-sm text-muted-foreground first-letter:uppercase">
			{description}
		</p>

		<ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted-foreground">
			{tags.map((tag) => (
	<li class="inline-flex items-center gap-1.5">
		<span aria-hidden="true" class="size-1.5 bg-accent/70" />
		{tag}
	</li>
))}
		</ul>
	</div>

	<div class="col-start-2 flex gap-4 font-mono text-sm sm:col-start-auto sm:flex-col sm:items-end sm:gap-1 sm:pt-1">
		{links.map((link) => (
	<a
		class="inline-flex items-center text-muted-foreground underline-offset-4 transition-colors hover:text-primary hover:underline"
		href={link.href}
		rel="noreferrer"
		target="_blank"
	>
		{link.label} <PopupArrow />
	</a>
))}
	</div>
</li>
