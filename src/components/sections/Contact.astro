---
import PopupArrow from "@/assets/icons/popup-arrow.svg";
import Section from "@/components/ui/Section.astro";
import { socials } from "@/data/socials";

const channels = Object.entries(socials).map(([label, href]) => ({
	label,
	href,
	host: new URL(href).hostname.replace(/^www\./, ""),
}));
---

<Section id="contact" title="Get in touch">
	<ul class="grid gap-3 sm:grid-cols-3">
		{
			channels.map(({ label, href, host }) => (
				<li>
					<a
						class="group flex h-full items-center justify-between gap-4 border border-border bg-background/60 py-4 pr-4 pl-5 transition-colors hover:border-primary hover:bg-primary/4"
						href={href}
						rel="noreferrer"
						target="_blank"
					>
						<span class="min-w-0">
							<span class="block text-xl font-semibold tracking-tight transition-colors group-hover:text-primary">
								{label}
							</span>
							<span class="mt-0.5 block truncate font-mono text-xs text-muted-foreground">
								{host}
							</span>
						</span>

						<span class="grid size-10 shrink-0 place-items-center border border-border text-muted-foreground transition-colors group-hover:border-primary group-hover:bg-primary group-hover:text-primary-foreground">
							<span class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
								<PopupArrow />
							</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
</Section>
