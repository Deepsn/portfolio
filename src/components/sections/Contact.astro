---
import Section from "@/components/ui/Section.astro";
import { socials } from "@/data/site";
---

<Section id="contact" title="find me on">
	<ul class="border-t border-border">
		{Object.entries(socials).map(([label, href], index) => (
	<li>
		<a
			class="group flex items-center justify-between gap-6 border-b border-border py-4 transition-colors hover:bg-primary/[0.03]"
			href={href}
			rel="noreferrer"
			target="_blank"
		>
			<span class="flex items-baseline gap-5">
				<span class="font-mono text-xs text-muted-foreground group-hover:text-primary">
					{String(index + 1).padStart(2, "0")}
				</span>
				<span
					class="text-lg font-semibold tracking-tight transition-all duration-300 group-hover:translate-x-2 group-hover:text-primary"
				>
					{label}
				</span>
			</span>
			<span class="flex items-center gap-3 font-mono text-sm text-muted-foreground group-hover:text-foreground">
				<span class="hidden sm:inline">{new URL(href).hostname}</span>
				<span class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
			</span>
		</a>
	</li>
))}
	</ul>

	<p class="mt-10 font-mono text-xs text-muted-foreground">
		the background is a live langton's ant running on top of conway's game of life.
	</p>
</Section>
