---
interface Props {
	title: string;
	description: string;
	tags?: string[];
	links?: { label: string; href: string }[];
}

const { title, description, tags = [], links = [] } = Astro.props;
---

<article class="flex flex-col gap-0.5 text-base sm:text-xl text-white min-w-0 wrap-break-word">
	<h2 class="text-2xl sm:text-3xl leading-tight">{title}</h2>
	<p class="font-light">{description}</p>

	{tags.length > 0 && <p class="mt-3 font-light sm:mt-4 text-neutral-400">{tags.join(" / ")}</p>}

	{links.length > 0 && (
			<div class="flex flex-wrap gap-x-3 gap-y-1 mt-1 sm:mt-0 sm:pl-28">
				{links.map((link) => (
					<a href={link.href} rel="noreferrer" target="_blank">
						{link.label}
					</a>
				))}
			</div>
		)}
</article>
