---
import hiGif from "../assets/hi.gif";
---

<div class="w-full flex-1 min-h-0 flex items-center justify-center text-white">
	<div class="flex flex-col gap-16 text-xl">
		<div class="text-3xl leading-tight">
			<div class="flex items-baseline gap-4">
				<span>Hi my name is</span>
			</div>
			<p>
				Speed
				<img alt="hi" class="ml-6 w-20 h-12 inline-block" src={hiGif.src}>
			</p>
		</div>

		<div class="flex flex-col gap-0.5">
			<p>i am a software engineer</p>
			<p>and a gamedev</p>
			<p>majorly Roblox but love to learn new things</p>

			<p class="mt-4">checkout my socials</p>
			<div class="flex gap-3 pl-28">
				<a href="https://github.com/Deepsn">github</a>
				<a href="https://www.roblox.com/users/78662128/profile">roblox</a>
				<a href="https://discord.com/users/1108877024921145364">discord</a>
			</div>
		</div>
	</div>
</div>
