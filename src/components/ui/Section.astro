---
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<section class="scroll-mt-24 p-6 sm:p-10 lg:p-14" id={id}>
	<h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
	<div aria-hidden="true" class="cell-rule mt-6" />

	<div class="mt-8">
		<slot />
	</div>
</section>
