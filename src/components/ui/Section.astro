---
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<section class="scroll-mt-24 p-6 sm:p-10 lg:p-14" id={id}>
	<header>
		<h2
			class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
			id={`${id}-title`}
		>
			{title}
		</h2>
	</header>

	<div class="mt-10">
		<slot />
	</div>
</section>
